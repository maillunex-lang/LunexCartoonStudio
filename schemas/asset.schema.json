{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "kind",
    "source",
    "license",
    "sha256",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "kind": {
      "enum": [
        "character",
        "animation",
        "environment",
        "prop"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
